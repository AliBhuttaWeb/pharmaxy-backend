enum SystemLogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}

enum SystemLogSource {
  AUTH
  API
  DATABASE
  INVENTORY
  POS
  PURCHASE
  SALE
  PAYMENT
  SUBSCRIPTION
  NOTIFICATION
  CRON
  SYSTEM
}

model SystemLog {
  id String @id @default(uuid()) @db.Uuid

  pharmacy_id String? @db.Uuid
  branch_id   String? @db.Uuid
  user_id     String? @db.Uuid

  level  SystemLogLevel
  source SystemLogSource

  event   String @db.VarChar(150)
  message String @db.Text

  context Json? @db.JsonB

  ip_address String? @db.VarChar(50)
  user_agent String? @db.Text

  created_at DateTime @default(now())

  //////////////////////////////////////////////////////
  // Relations
  //////////////////////////////////////////////////////

  pharmacy Pharmacy? @relation(fields: [pharmacy_id], references: [id], onDelete: SetNull)

  branch Branch? @relation(fields: [branch_id], references: [id], onDelete: SetNull)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([level])
  @@index([source])
  @@index([created_at])
  @@index([pharmacy_id])
  @@index([branch_id])
  @@index([user_id])

  @@map("system_logs")
}

